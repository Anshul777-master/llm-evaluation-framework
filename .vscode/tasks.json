{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sentinel: Frontend",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Sentinel: Backend",
      "type": "shell",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
        "options": { "cwd": "${workspaceFolder}\\backend" }
      },
      "linux": {
        "command": "${workspaceFolder}/.venv/bin/python -m uvicorn app.main:app --reload --port 8000",
        "options": { "cwd": "${workspaceFolder}/backend" }
      },
      "osx": {
        "command": "${workspaceFolder}/.venv/bin/python -m uvicorn app.main:app --reload --port 8000",
        "options": { "cwd": "${workspaceFolder}/backend" }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Sentinel: Start everything",
      "dependsOrder": "parallel",
      "dependsOn": ["Sentinel: Frontend", "Sentinel: Backend"],
      "problemMatcher": []
    }
  ]
}
